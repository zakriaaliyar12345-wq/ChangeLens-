    <!-- Education / legacy demos -->
    <string name="education_title">نمایش‌های درسی</string>
    <string name="education_intro">این صفحه مفاهیم درسی را نشان می‌دهد. قابلیت‌های واقعی ChangeLens از APIهای نوین استفاده می‌کنند؛ APIهای قدیمی فقط برای یادگیری اینجا جداگانه نشان داده می‌شوند.</string>
    <string name="demo_async_task">اجرای نمایش AsyncTask (قدیمی)</string>
    <string name="demo_async_task_desc">شبیه‌سازی کار پس‌زمینه با API منسوخ AsyncTask و نشان دادن دیالوگ پیشرفت. کد واقعی از executor استفاده می‌کند.</string>
    <string name="demo_loader">اجرای نمایش AsyncTaskLoader (قدیمی)</string>
    <string name="demo_loader_desc">بارگذاری نکات با AsyncTaskLoader مدیریت‌شده از طریق LoaderManager و نشان دادن چرخه حیات بارگذار.</string>
    <string name="demo_job_scheduler">زمان‌بندی کار نگهداری ذخیره‌سازی</string>
    <string name="demo_job_scheduler_desc">صف کردن یک کار JobScheduler برای پاک‌سازی فایل‌های ریزعکس یتیم — یک کار واقعی تأخیری که برنامه استفاده می‌کند.</string>
    <string name="demo_service">اجرای سرویس برون‌بری</string>
    <string name="demo_service_desc">شروع سرویس برون‌بری گزارش در پس‌زمینه — همان سرویسی که برون‌بری‌های واقعی پروژه استفاده می‌کنند.</string>
