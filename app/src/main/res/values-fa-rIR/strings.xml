    <!-- Help -->
    <string name="help_title">راهنما</string>
    <string name="help_onboarding_title">به ChangeLens خوش آمدید</string>
    <string name="help_onboarding_body">ChangeLens یک ماشین زمان تصویری است. یک پروژه ایجاد کنید، به‌مرور عکس اضافه کنید، سپس با اسلایدر یا همپوشانی شفاف، دو عکس را کنار هم مقایسه کنید تا دقیق ببینید چه چیزی تغییر کرده است.</string>
    <string name="help_step1">۱. یک پروژه با عنوان و دسته‌بندی ایجاد کنید.</string>
    <string name="help_step2">۲. عکس‌ها را با عنوان و تاریخ از دوربین یا گالری اضافه کنید.</string>
    <string name="help_step3">۳. هر دو عکسی را انتخاب کنید و با اسلایدر یا همپوشانی مقایسه کنید.</string>
    <string name="help_step4">۴. یادداشت اضافه کنید، تصویر مقایسه را برون‌بری کنید یا گزارش پیشرفت را هم‌رسانی کنید.</string>
    <string name="help_offline_title">کاملاً آفلاین کار می‌کند</string>
    <string name="help_offline_body">همه‌چیز به‌صورت محلی ذخیره می‌شود. هرگز به اتصال اینترنت نیازی نیست.</string>
    <string name="help_got_it">متوجه شدم</string>
    <string name="help_dont_show_again">این خوش‌آمدگویی را دیگر نشان نده</string>
    <string name="help_open_demos">باز کردن نمایش‌های درسی</string>

    <!-- Education / legacy demos -->
    <string name="education_title">نمایش‌های درسی</string>
    <string name="education_intro">این صفحه مفاهیم درسی را نمایش می‌دهد. قابلیت‌های واقعی ChangeLens از APIهای مدرن استفاده می‌کنند؛ APIهای قدیمی فقط برای آموزش اینجا جداگانه نمایش داده می‌شوند.</string>
    <string name="demo_async_task">اجرای نمایش AsyncTask (قدیمی)</string>
    <string name="demo_async_task_desc">شبیه‌سازی کار پس‌زمینه با API منسوخ AsyncTask و نمایش گفت‌وگوی پیشرفت. کد واقعی از executor استفاده می‌کند.</string>
    <string name="demo_loader">اجرای نمایش AsyncTaskLoader (قدیمی)</string>
    <string name="demo_loader_desc">بارگذاری نکات با AsyncTaskLoader مدیریت‌شده از طریق LoaderManager و نمایش چرخه‌حالا بارگذار.</string>
    <string name="demo_job_scheduler">زمان‌بندی کار نگهداری حافظه</string>
    <string name="demo_job_scheduler_desc">صف کردن یک کار JobScheduler برای پاک‌سازی فایل‌های ریزتصویر یتیم — یک کار واقعی تأخیری که برنامه استفاده می‌کند.</string>
    <string name="demo_service">اجرای سرویس برون‌بری</string>
    <string name="demo_service_desc">شروع سرویس برون‌بری گزارش در پس‌زمینه — همان سرویسی که برون‌بری‌های واقعی پروژه استفاده می‌کنند.</string>
