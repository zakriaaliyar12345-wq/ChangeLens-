    <!-- Help -->
    <string name="help_title">Help</string>
    <string name="help_onboarding_title">Welcome to ChangeLens</string>
    <string name="help_onboarding_body">ChangeLens is a visual time machine. Create a project, add photos over time, then compare them side by side with a slider or transparent overlay to see exactly how things changed.</string>
    <string name="help_step1">1. Create a project with a title and category.</string>
    <string name="help_step2">2. Add photos from the camera or gallery with captions and dates.</string>
    <string name="help_step3">3. Select any two photos and compare them with the slider or overlay.</string>
    <string name="help_step4">4. Add annotations, export a comparison image, or share a progress report.</string>
    <string name="help_offline_title">Works fully offline</string>
    <string name="help_offline_body">Everything is stored locally. No internet connection is ever required.</string>
    <string name="help_got_it">Got it</string>
    <string name="help_dont_show_again">Do not show this welcome again</string>
    <string name="help_open_demos">Open course demos</string>

    <!-- Education / legacy demos -->
    <string name="education_title">Course demos</string>
    <string name="education_intro">These screens demonstrate course concepts. Production features in ChangeLens use modern APIs; legacy APIs are isolated here for learning only.</string>
    <string name="demo_async_task">Run AsyncTask demo (legacy)</string>
    <string name="demo_async_task_desc">Simulates background work with the deprecated AsyncTask API and shows a progress dialog. Production code uses executors instead.</string>
    <string name="demo_loader">Run AsyncTaskLoader demo (legacy)</string>
    <string name="demo_loader_desc">Loads tips with a managed AsyncTaskLoader via LoaderManager, demonstrating loader lifecycle callbacks.</string>
    <string name="demo_job_scheduler">Schedule storage maintenance job</string>
    <string name="demo_job_scheduler_desc">Queues a JobScheduler job that cleans orphaned thumbnail files — a real deferred-maintenance task used by the app.</string>
    <string name="demo_service">Run export service</string>
    <string name="demo_service_desc">Starts the report export Service in the background — the same service used by real project exports.</string>
